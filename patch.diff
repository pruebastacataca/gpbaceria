Subject: [PATCH] CodeQL

---
 .github/workflows/main.yml | 68 ++++++++++++++++++--------------------
 1 file changed, 33 insertions(+), 35 deletions(-)

diff --git a/.github/workflows/main.yml b/.github/workflows/main.yml
index d42779c..7a11060 100644
--- a/.github/workflows/main.yml
+++ b/.github/workflows/main.yml
@@ -2,8 +2,6 @@
 name: Pipeline CI / CD
 
 on:
-# push:
-#   branches: [ "main" ]
   pull_request:
     branches: [ "main" ]
 
@@ -15,18 +13,44 @@ jobs:
   deploy:
     name: CI
     runs-on: ubuntu-latest
+    permissions:
+      actions: read
+      contents: read
+      security-events: write
+
+    strategy:
+      fail-fast: false
+      matrix:
+        language: [ 'csharp' ]
+
+
 
     steps:
     # paso 1: se hace checkout del código fuente del repositorio
     - name: Checkout Code
       uses: actions/checkout@v4
       with:
-        fetch-depth: 0 # Required by SonarQube for better analysis relevance
+        fetch-depth: 0 
+
+    - name: Initialize CodeQL
+      uses: github/codeql-action/init@v3
+      with:
+        languages: ${{ matrix.language }}
+        queries: security-extended
+
+    - name: Autobuild
+      uses: github/codeql-action/autobuild@v3
+
+    - name: Perform CodeQL Analysis
+      uses: github/codeql-action/analyze@v3
+      with:
+        category: "/language:${{matrix.language}}"
+
 
     - name: Setup .NET SDK
       uses: actions/setup-dotnet@v4
       with:
-        dotnet-version: '10.0' # Change to '9.0.x' or your specific .NET version
+        dotnet-version: '10.0' 
 
     # paso 2: se ejecutan las pruebas unitarias y se construye la solución
     - name: Restore dependencies
@@ -38,20 +62,7 @@ jobs:
     - name: Run bUnit Tests
       run: dotnet test --no-build --verbosity normal
 
-    
-    # Paso 3: Scan the raw source code using SonarQube
-    #- name: SonarQube Scan
-    #  uses: sonarsource/sonarqube-scan-action@v4
-    #  env:
-    #    SONAR_TOKEN: ${{ secrets.SONAR_TOKEN }}
-    #    SONAR_HOST_URL: ${{ secrets.SONAR_HOST_URL }} # Remove if using SonarCloud
-      
-      # Optional: Force the workflow to fail if SonarQube Quality Gate fails
-      # with:
-      #   args: >
-      #     -Dsonar.qualitygate.wait=true
-
-    # Paso 4: Configura Credenciales AWS
+    # Paso 3: Configura Credenciales AWS
     - name: Configure AWS Credentials
       uses: aws-actions/configure-aws-credentials@v4
       with:
@@ -59,12 +70,12 @@ jobs:
         aws-secret-access-key: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
         aws-region: us-east-1
 
-    # Paso 5: Login to Amazon ECR
+    # Paso 4: Login to Amazon ECR
     - name: Login to Amazon ECR
       id: login-ecr
       uses: aws-actions/amazon-ecr-login@v2
 
-    # Paso 6: Build Docker Image locally
+    # Paso 5: Build Docker Image locally
     - name: Build Docker Image
       env:
         ECR_REGISTRY: ${{ steps.login-ecr.outputs.registry }}
@@ -73,7 +84,7 @@ jobs:
       run: |
         docker build -t $ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG -t $ECR_REGISTRY/$ECR_REPOSITORY:latest .
 
-    # Paso 7: Escanear con Trivy para buscar vulnerabilidades en la imagen Docker
+    # Paso 6: Escanear con Trivy para buscar vulnerabilidades en la imagen Docker
     - name: Run Trivy Vulnerability Scanner
       uses: aquasecurity/trivy-action@master
       with:
@@ -87,7 +98,7 @@ jobs:
       run: |
         aws eks update-kubeconfig --name eks-aceria-east1 --region us-east-1
 
-    # Paso 8: Push to ECR only if both SonarQube and Trivy checks pass
+    # Paso 7: Push to ECR only if both SonarQube and Trivy checks pass
     - name: Push Image to Amazon ECR
       env:
         ECR_REGISTRY: ${{ steps.login-ecr.outputs.registry }}
@@ -105,16 +116,3 @@ jobs:
         kubectl rollout restart deployment.app/gpbaceria-app
 
 
